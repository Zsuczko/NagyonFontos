<Window x:Class="IngatlanGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IngatlanGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="resultTable" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="resultTable_SelectionChanged"/>
        <StackPanel Grid.Column="1">
            <Label x:Name="feladat2Label" Content="Szobák száma: "/>
            <ComboBox x:Name="feladat3Box"/>
            <Button x:Name="feladat3Button" Content="Falazat" Click="feladat3Button_Click"/>
            <Label x:Name="feladat4Label" Content="Összterület: "/>
            <Button x:Name="feladat5Button" Content="Legalább 2 ingatlan eladva" Click="feladat5Button_Click"/>
            <ListBox x:Name="legalabb2Lista" Height="100" d:ItemsSource="{d:SampleData ItemCount=5}"/>
            <Button x:Name="feladat6Button" Content="Összbevétel" Click="feladat6Button_Click"/>
            <Button x:Name="felaat7Button" Content="Legdrágább, még nem eladott ingatlan" Click="felaat7Button_Click"/>
        </StackPanel>

    </Grid>
</Window>
